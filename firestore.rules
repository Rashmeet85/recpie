rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verify user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if user document exists and has admin role
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('.*admin.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // 1. Staff & User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // 2. Student Directory
    // Authenticated staff can read student roster; Super Admins can register/edit/delete
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 3. Attendance Records
    // Authenticated staff can mark attendance; records are accessible to team
    match /attendance_records/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // 4. Audit & Sync Logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // 5. System Counters (for atomic unique ID generation)
    match /system_counters/{counterId} {
      allow read, write: if isSignedIn();
    }
  }
}
